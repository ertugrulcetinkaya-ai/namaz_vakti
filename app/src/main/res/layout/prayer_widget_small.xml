<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/WidgetRoot" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background">
    <ImageView android:id="@+id/widget_pattern_image" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/widget_pattern_small" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingLeft="8dp" android:paddingRight="8dp">
    <TextView android:id="@+id/prayer_widget_next_prayer" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:singleLine="true" android:textColor="@color/widget_hijri_text" android:textSize="14sp" android:fontFamily="@font/noto_serif_italic" />
    <Chronometer android:id="@+id/prayer_widget_chronometer" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:singleLine="true" android:textColor="@color/widget_active_text" android:textSize="30sp" android:fontFamily="@font/inter_semibold" android:fontFeatureSettings="tnum" />
    <TextView android:id="@+id/prayer_widget_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:singleLine="true" android:textColor="@color/widget_secondary_text" android:textSize="12sp" android:fontFamily="@font/inter_medium" android:fontFeatureSettings="tnum" />
    <TextView android:id="@+id/prayer_widget_date" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/prayer_widget_prayer_grid" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:visibility="gone" />
    <TextView android:id="@+id/prayer_widget_ramadan" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/prayer_widget_province_center" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
