<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/WidgetRoot"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="5dp"
    android:paddingRight="5dp">

    <TextView
        android:id="@+id/prayer_widget_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/widget_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/prayer_widget_next_prayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/widget_active_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Chronometer
        android:id="@+id/prayer_widget_chronometer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/widget_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/prayer_widget_date"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/prayer_widget_prayer_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <TextView android:id="@+id/prayer_widget_item_1" style="@style/WidgetPrayerItem" />
        <TextView android:id="@+id/prayer_widget_item_2" style="@style/WidgetPrayerItem" />
        <TextView android:id="@+id/prayer_widget_item_3" style="@style/WidgetPrayerItem" />
        <TextView android:id="@+id/prayer_widget_item_4" style="@style/WidgetPrayerItem" />
        <TextView android:id="@+id/prayer_widget_item_5" style="@style/WidgetPrayerItem" />
        <TextView android:id="@+id/prayer_widget_item_6" style="@style/WidgetPrayerItem" />
    </LinearLayout>

    <TextView
        android:id="@+id/prayer_widget_ramadan"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:textSize="16sp"
        android:visibility="gone" />
</LinearLayout>
