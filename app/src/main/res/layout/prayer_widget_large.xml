<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/WidgetRoot"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="@dimen/widget_padding_horizontal"
    android:paddingRight="@dimen/widget_padding_horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/prayer_widget_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/widget_text"
        android:textSize="@dimen/widget_city_text_size"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/prayer_widget_next_prayer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/widget_active_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/prayer_widget_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/widget_text"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/prayer_widget_prayer_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/prayer_widget_item_1" style="@style/WidgetPrayerItemLarge" />
            <TextView android:id="@+id/prayer_widget_item_2" style="@style/WidgetPrayerItemLarge" />
            <TextView android:id="@+id/prayer_widget_item_3" style="@style/WidgetPrayerItemLarge" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/prayer_widget_item_4" style="@style/WidgetPrayerItemLarge" />
            <TextView android:id="@+id/prayer_widget_item_5" style="@style/WidgetPrayerItemLarge" />
            <TextView android:id="@+id/prayer_widget_item_6" style="@style/WidgetPrayerItemLarge" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/prayer_widget_date"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:textSize="18sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/prayer_widget_ramadan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/widget_active_text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
