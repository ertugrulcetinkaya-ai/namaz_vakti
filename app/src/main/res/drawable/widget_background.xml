<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_background_radius" />
            <solid android:color="@color/widget_background" />
        </shape>
    </item>
    <item
        android:left="@dimen/widget_background_inset"
        android:top="@dimen/widget_background_inset"
        android:right="@dimen/widget_background_inset"
        android:bottom="@dimen/widget_background_inset">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_inner_corner_radius" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/widget_outline" />
        </shape>
    </item>
</layer-list>
